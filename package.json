{
  "name": "cloodsy-s3-gui",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "dev:setup": "vite --config vite.setup.config.ts",
