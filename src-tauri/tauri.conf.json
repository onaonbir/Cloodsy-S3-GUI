{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloodsy S3 GUI",
  "mainBinaryName": "cloodsy-s3",
  "version": "../package.json",
  "identifier": "com.onaonbir.cloodsys3gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cloodsy S3",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzOEMwNTVFQjAxMDZEQjcKUldTM2JSQ3dYZ1dNNDlGZGl3VE1VVzBXcUoyRlN0YUZ5azdEbCs1YjIxZ1VTZnF0NjRNemFsK00K",
      "endpoints": ["https://github.com/onaonbir/Cloodsy-S3-GUI/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
